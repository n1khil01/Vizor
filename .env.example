# Vizor — template. Committed to git. Copy to .env and fill in real values.
#
#   cp .env.example .env
#
# Never put real secrets in this file.

# ---------------------------------------------------------------------------
# ASU AI Research LLM (OpenAI-compatible)
# Used only by the FastAPI backend. Never expose to the extension or frontend.
# ---------------------------------------------------------------------------
ASU_API_BASE_URL=https://openai.rc.asu.edu/v1
ASU_API_KEY=sk-your-asu-key-here
ASU_CHAT_MODEL=model-name-here
ASU_EMBEDDING_MODEL=embedding-model-name-here

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Next.js frontend (advisor web app + landing page)
# NEXT_PUBLIC_* values are bundled into client JS — never put a secret here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
