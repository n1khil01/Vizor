{
  "manifest_version": 3,
  "name": "Vizor",
  "version": "0.1.0",
  "description": "AI advising assistant for ASU students.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*"],
  "icons": {
    "16": "icons/logo-16.png",
    "32": "icons/logo-32.png",
    "48": "icons/logo-48.png",
    "128": "icons/logo-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/logo-16.png",
      "32": "icons/logo-32.png",
      "48": "icons/logo-48.png",
      "128": "icons/logo-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.asu.edu/*"],
      "js": ["config.js", "styles.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/logo.png"],
      "matches": ["*://*.asu.edu/*"]
    }
  ]
}
